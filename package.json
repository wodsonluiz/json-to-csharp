{
  "name": "json-to-csharp",
  "displayName": "json-to-csharp",
  "description": "Extension convert json to csharp class",
  "version": "1.0.6",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:json-to-csharp.convert",
    "onLanguage:json",
    "onCommand:json-to-csharp.convertToYaml",
    "onCommand:json-to-csharp.convertToRecord",
    "onCommand:json-to-csharp.convertToXml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "json-to-csharp.convert",
        "title": "Convert JSON to C# Class"
      },
      {
        "command": "json-to-csharp.convertToYaml",
        "title": "Convert JSON to YAML"
      },
      {
        "command": "json-to-csharp.convertToRecord",
        "title": "Convert JSON to C# Record"
      },
      {
        "command": "json-to-csharp.convertToXml",
        "title": "Convert JSON to XML"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "json-to-csharp.convert",
          "when": "editorLangId == json",
          "group": "navigation"
        },
        {
          "command": "json-to-csharp.convertToYaml",
          "when": "editorLangId == json",
          "group": "navigation"
        },
        {
          "command": "json-to-csharp.convertToRecord",
          "when": "editorLangId == json",
          "group": "navigation"
        },
        {
          "command": "json-to-csharp.convertToXml",
          "when": "editorLangId == json",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "json-to-csharp.convert",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "json-to-csharp.convertToYaml",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "json-to-csharp.convertToRecord",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "json-to-csharp.convertToXml",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile && esbuild src/extension.ts --bundle --platform=node --target=node22 --external:vscode --outfile=dist/extension.js",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --max-warnings=0",
    "test": "node --test test/*.test.cjs && python3 -m unittest discover -s test -p \"*_test.py\"",
    "package": "vsce package --no-dependencies --out extension.vsix",
    "check:vsix": "python3 scripts/check-vsix.py extension.vsix",
    "audit:security": "node scripts/check-audit.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "@types/vscode": "^1.109.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "quicktype-core": "^23.2.6",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wodsonluiz/json-to-csharp"
  },
  "publisher": "wodson",
  "icon": "icon.png",
  "license": "MIT",
  "homepage": "https://wodson.net/projects",
  "bugs": {
    "url": "https://github.com/wodsonluiz/json-to-csharp/issues"
  }
}
